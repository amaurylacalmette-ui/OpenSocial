generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model SocialAccount {
  id          String   @id @default(cuid())
  platform    String // x | instagram | tiktok | linkedin | facebook | threads | bluesky | mastodon | youtube | pinterest | reddit
  username    String
  displayName String
  avatarColor String   @default("#7c3aed")
  followers   Int      @default(0)
  autoPost    Boolean  @default(true)
  status      String   @default("connected") // connected | expired
  connectedAt DateTime @default(now())
  targets     PostTarget[]
  snapshots   FollowerSnapshot[]

  @@unique([platform, username])
}

model Post {
  id          String       @id @default(cuid())
  content     String
  mediaUrl    String?
  status      String       @default("draft") // draft | scheduled | queued | published | failed
  scheduledAt DateTime?
  publishedAt DateTime?
  source      String       @default("composer") // composer | automation | ai
  automationId String?
  targets     PostTarget[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model PostTarget {
  id        String   @id @default(cuid())
  postId    String
  accountId String
  platform  String
  content   String?
  status    String   @default("pending") // pending | published | failed | scheduled
  likes     Int      @default(0)
  comments  Int      @default(0)
  shares    Int      @default(0)
  impressions Int    @default(0)
  clicks    Int      @default(0)
  publishedAt DateTime?
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  account   SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model Automation {
  id             String   @id @default(cuid())
  name           String
  sourcePlatform String
  targetPlatforms String  // JSON array of platform ids
  delayMinutes   Int      @default(0)
  template       String?  // optional appended text like "via @handle"
  enabled        Boolean  @default(true)
  runs           Int      @default(0)
  createdAt      DateTime @default(now())
}

model FollowerSnapshot {
  id        String   @id @default(cuid())
  accountId String
  date      DateTime
  followers Int
  account   SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, date])
}

model ChatMessage {
  id        String   @id @default(cuid())
  role      String // user | assistant | system
  content   String
  provider  String?
  model     String?
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}
